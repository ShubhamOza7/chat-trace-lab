# ---------------------------------------------------------------------------
# Model access (required)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
# anthropic = direct Anthropic SDK, langchain = LangChain ChatAnthropic
CHAT_BACKEND=anthropic
CHAT_MODEL=claude-opus-5
CHAT_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Tracing
# ---------------------------------------------------------------------------
# console | otlp | both | none
TRACE_EXPORTER=both

# Name your app shows up as in the tracing product
OTEL_SERVICE_NAME=chat-trace-lab

# OTLP/HTTP collector endpoint (base URL, no /v1/traces suffix)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Extra headers, comma separated k=v (auth tokens etc.)
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20xxx

# Set false to send spans without prompt/response text (PII-safe mode)
CAPTURE_MESSAGE_CONTENT=true

# ---------------------------------------------------------------------------
# Convenience: if these two are set, the Basic auth header for Langfuse's
# OTLP endpoint is built for you. Leave blank for any other backend.
# ---------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
